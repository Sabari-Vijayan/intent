# Used by scripts/generate-environment.mjs during production builds.
# These are public Supabase browser credentials, not service-role credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Used only by Supabase Edge Functions. Set this with `supabase secrets set`
# or in an untracked local function env file; never expose it to Angular.
# SARVAM_API_KEY=YOUR_SARVAM_API_KEY
